# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# APP_ENCRYPTION_KEY: 32-byte hex or base64 key for AES-256-GCM field-level encryption (auto-derived in dev if unset)
APP_ENCRYPTION_KEY=""

# DATABASE_URL: PostgreSQL connection string for production/Docker Prisma setup
DATABASE_URL="postgresql://meridian:meridian_dev@localhost:5432/meridian_visa?schema=public"

# SQLITE_PATH: Local SQLite database path for zero-setup Node runtime
SQLITE_PATH="./data/meridian.db"

# REDIS_URL: Redis connection string for BullMQ job queues in Docker/production
REDIS_URL="redis://localhost:6379"

# S3 Storage configuration (MinIO in Docker Compose or AWS S3 in production)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="meridian-documents-private"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
